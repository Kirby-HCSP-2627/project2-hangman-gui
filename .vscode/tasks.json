{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup Python Environment",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/.vscode/setup.ps1"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/.vscode/setup.sh"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/.vscode/setup.sh"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
