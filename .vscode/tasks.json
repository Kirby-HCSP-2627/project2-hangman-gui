{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup Portable Python Environment",
      "type": "shell",
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File setup.ps1"
      },
      "osx": {
        "command": "bash setup.sh"
      },
      "linux": {
        "command": "bash setup.sh"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
